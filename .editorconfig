# Read by nearly every editor, with or without a Prettier plugin: https://editorconfig.org
# These values mirror .prettierrc.json, so files look the same before and after formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 110

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
