# Copy to .env (or set in docker-compose) and change what you need. Every value is optional.

# Where photos, videos, accounts and settings are kept. Mount a volume here in Docker.
DATA_DIR=./data

# Friends area: people outside the admin team see private photos with one shared passcode.
# false = no passcode, no unlock page; private items only for admins with private access.
FRIENDS_ENABLED=true

# Starting branding. The super admin changes these (and the logo) in Dashboard › Branding.
SITE_NAME=Memory
SITE_ORGANIZATION=Acme Inc.
# SITE_TAGLINE=Photo and video archive
# SITE_DESCRIPTION=Celebrations, gatherings and everyday life at the company.

# Starting brand colours as #rrggbb. Every shade for the light and dark theme is derived from them.
# BRAND_PRIMARY_COLOR=#2f5bd0
# BRAND_SECONDARY_COLOR=#0e8a83

# Upload limits in MB.
MAX_UPLOAD_MB=100
MAX_VIDEO_UPLOAD_MB=2048

# Signs the session cookies. At least 32 characters; without it a random one is kept in data/settings.json.
# Changing it signs everyone out.
# SESSION_SECRET=

# Secure cookies: auto (from X-Forwarded-Proto), always or never.
COOKIE_SECURE=auto

# Trust X-Real-IP / X-Forwarded-For from the reverse proxy. Set false when the app is reached directly.
TRUST_PROXY=true

# Use system binaries instead of the ones installed by npm.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
